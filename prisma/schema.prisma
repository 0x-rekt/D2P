generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  repositories Repository[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Repository {
  id            String  @id @default(uuid())
  repoGithubId  Int     @unique
  fullName      String
  name          String
  private       Boolean @default(false)
  defaultBranch String  @default("main")
  language      String?
  description   String?
  htmlUrl       String

  webhookId     Int?
  webhookSecret String?

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pullRequests     PullRequest[]
  ciFailures       CiFailure[]
  securityFindings SecurityFinding[]
  securityScores   RepositorySecurityScore[]

  @@index([userId])
  @@index([repoGithubId])
  @@map("repository")
}

model PullRequest {
  id           String  @id @default(uuid())
  prNumber     Int
  prGithubId   BigInt  @unique
  title        String
  body         String?
  state        String  @default("open")
  headSha      String
  baseBranch   String
  headBranch   String
  authorLogin  String
  diffUrl      String
  prUrl        String
  appliedPrUrl String?

  reviewStatus String    @default("pending")
  reviewedAt   DateTime?

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  suggestions      Suggestion[]
  securityFindings SecurityFinding[]

  @@unique([repositoryId, prNumber])
  @@index([repositoryId])
  @@index([reviewStatus])
  @@map("pull_request")
}

model Suggestion {
  id            String @id @default(uuid())
  filePath      String
  startLine     Int
  endLine       Int
  type          String
  severity      String
  comment       String
  originalCode  String
  suggestedCode String
  status        String @default("pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pullRequestId String
  pullRequest   PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  @@index([pullRequestId])
  @@index([status])
  @@map("suggestion")
}

model CiFailure {
  id            String @id @default(uuid())
  workflowRunId BigInt @unique
  workflowName  String
  branch        String
  commitSha     String
  conclusion    String
  logsUrl       String
  htmlUrl       String

  diagnosis      String?
  rootCause      String?
  fixSummary     String?
  suggestedPatch String?

  analysisStatus String  @default("pending")
  appliedUrl     String?

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repositoryId])
  @@index([analysisStatus])
  @@map("ci_failure")
}

model SecurityFinding {
  id             String  @id @default(uuid())
  prNumber       Int?
  commitSha      String
  findingType    String // "secret", "cve", "owasp", "dependency"
  severity       String // "critical", "high", "medium", "low"
  title          String
  description    String
  cveId          String?
  cvssScore      Float?
  packageName    String? // for CVE findings
  packageVersion String? // for CVE findings
  filePath       String? // for secrets/code findings
  lineNumber     Int?
  fixable        Boolean @default(false)
  fixType        String? // "secret_rotation", "dependency_upgrade", "code_patch"
  fixDetails     String? // JSON with upgrade version, patch code, etc.

  status         String  @default("open") // "open", "fixed", "ignored", "false_positive"
  githubIssueId  Int?
  gitHubIssueUrl String?

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  pullRequestId String?
  pullRequest   PullRequest? @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repositoryId])
  @@index([prNumber])
  @@index([status])
  @@index([severity])
  @@index([findingType])
  @@map("security_finding")
}

model RepositorySecurityScore {
  id           String     @id @default(uuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  // Score breakdown (0-100)
  overallScore Int
  secretScore  Int // No secrets found
  cveScore     Int // No critical/high CVEs
  owaslScore   Int // OWASP patterns

  // Metrics
  criticalFindings Int @default(0)
  highFindings     Int @default(0)
  mediumFindings   Int @default(0)
  lowFindings      Int @default(0)

  // Trend
  scoredAt      DateTime @default(now())
  previousScore Int?

  @@unique([repositoryId, scoredAt])
  @@index([repositoryId])
  @@map("repository_security_score")
}
